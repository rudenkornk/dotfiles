{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./cli-plugins/agent-status"],
  "keybinds": {
    "prompt.editor": "alt+e",
    "app.exit": "ctrl+c,<leader>q",
    "session.sidebar.toggle": "ctrl+q",
    "session.verbosity.cycle": "ctrl+g",
    "session.toggle.thinking": "alt+g",
    "command.palette.show": "ctrl+o",
    "open.menu": "none",
    "session.list": "<leader>o",
    "session.tab.next": "ctrl+tab,<leader>l",
    "session.tab.previous": "<leader>h",
    "session.first": "home",
    "session.half.page.down": "ctrl+d,ctrl+v",
    "session.half.page.up": "ctrl+u",
    "session.line.down": "ctrl+e",
    "session.line.up": "ctrl+y",
    "session.child.next": "l,right",
    "session.child.previous": "h,left",
    "session.child.first": "<leader>j",
    "session.delete": "ctrl+x",
    "session.background": "<leader>b",
    "session.parent": "k,up",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "input.delete": "delete,shift+delete",
    "input.delete.to.line.start": "none",
    "input.move.up": "ctrl+p,up",
    "input.move.down": "ctrl+n,down",
    "input.visual.line.end": "none",
    "input.line.end": "none",
    "prompt.paste": "none",
    "input.newline": "return,shift+return",
    "input.submit": "ctrl+return",
    "stash.delete": "ctrl+x",
    "prompt.history.previous": "ctrl+p,up",
    "prompt.history.next": "ctrl+n,down",
    "composer.subagent.up": "up,k",
    "composer.subagent.down": "down,j",
    "composer.shell.up": "up,k",
    "composer.shell.down": "down,j",
    "dialog.select.page_up": "ctrl+u,pageup",
    "dialog.select.page_down": "ctrl+d,pagedown"
  }
}
