{
  "permissions": {
    "allow": ["Read(~/projects/dotfiles/**)", "Read(~/projects/arcadia/**)"],
    "deny": [
      "Read(//run/user/*/secrets/**)",
      "Edit(//run/user/*/secrets/**)",

      "Read(~/.config/sops/**)",
      "Edit(~/.config/sops/**)",

      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",

      "Read(~/.pki/**)",
      "Edit(~/.pki/**)",

      "Read(~/.local/share/keyrings/**)",
      "Edit(~/.local/share/keyrings/**)",

      "Read(~/.local/share/TelegramDesktop/**)",
      "Edit(~/.local/share/TelegramDesktop/**)",

      "Read(~/.config/mozilla/**)",
      "Edit(~/.config/mozilla/**)",

      "Read(~/.config/google-chrome/**)",
      "Edit(~/.config/google-chrome/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state running"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state running"
          },
          {
            "type": "command",
            "command": "tmux-agent-name set --source title"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state running"
          },
          {
            "type": "command",
            "command": "tmux-agent-name set --source title"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state done"
          },
          {
            "type": "command",
            "command": "tmux-agent-name set --source title"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state waiting"
          },
          {
            "type": "command",
            "command": "tmux-agent-name set --source title"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state done"
          },
          {
            "type": "command",
            "command": "tmux-agent-name set --source title"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state error"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-status set --state clear"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "theme": "dark",
  "editorMode": "normal",
  "skipAutoPermissionPrompt": true
}
