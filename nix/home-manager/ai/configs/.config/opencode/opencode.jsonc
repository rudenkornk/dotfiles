{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": ["@slkiser/opencode-quota@5.0.3"],
  "experimental": {
    "subagent_depth": 2,
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "~/Downloads/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/projects/arcadia*/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/projects/cloudia*/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/projects/dotfiles/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/projects/home-manager/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/projects/nixpkgs/**",
      "effect": "allow",
    },

    {
      "action": "external_directory",
      "resource": "~/.cache/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.cargo/registry/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/state/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.claude/skills/**",
      "effect": "allow",
    },

    {
      "action": "external_directory",
      "resource": "/bin/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/dev/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/etc/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/lib64/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/nix/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/run/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/sys/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/usr/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/var/**",
      "effect": "allow",
    },

    {
      "action": "external_directory",
      "resource": "/run/user/*/secrets/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/google-chrome/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/mozilla/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/sops/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/atuin/key",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/keyrings/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/TelegramDesktop/*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "~/.pki/*",
      "effect": "deny",
    },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "/**", "effect": "ask" },
    { "action": "edit", "resource": "/etc/**", "effect": "ask" },
    { "action": "edit", "resource": "/run/**", "effect": "ask" },
    { "action": "edit", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "/bin/**", "effect": "deny" },
    { "action": "edit", "resource": "/dev/**", "effect": "deny" },
    { "action": "edit", "resource": "/lib64/**", "effect": "deny" },
    { "action": "edit", "resource": "/nix/**", "effect": "deny" },
    { "action": "edit", "resource": "/sys/**", "effect": "deny" },
    { "action": "edit", "resource": "/usr/**", "effect": "deny" },
    { "action": "edit", "resource": "/var/**", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["mcp-nixos"],
      },
    },
  },
  "providers": {
    "openai": {},
  },
}
