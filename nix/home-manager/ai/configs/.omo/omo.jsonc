{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v5.1.40/assets/omo.schema.json",
  "telemetry": { "enabled": false },
  "git_master": { "commit_footer": false, "git_env_prefix": "" },
  "model_profile": "geeky-normal",
  "model_profiles": {
    "geeky-normal": {
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "medium",
        },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-5.6-sol", "reasoning": "medium" },
      ],
    },
    "geeky-heavy": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
      ],
    },
  },
  "agents": {
    "explore": {
      "model": "chatgpt-subscription/gpt-6-luna-fast",
      "reasoning": "low",
    },
    "librarian": {
      "model": "chatgpt-subscription/gpt-6-luna-fast",
      "reasoning": "low",
    },
    "plan-consultant": {
      "model": "chatgpt-subscription/gpt-6-astra",
      "reasoning": "high",
    },
    "plan-reviewer": {
      "model": "chatgpt-subscription/gpt-6-astra",
      "reasoning": "xhigh",
    },
  },
  "categories": {
    "quick": {
      "model": "chatgpt-subscription/gpt-6-luna-fast",
      "reasoning": "low",
    },
    "deep-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "medium",
        },
        { "model": "chatgpt-subscription/gpt-5.6-sol", "reasoning": "medium" },
        {
          "model": "chatgpt-subscription/gpt-5.6-sol-fast",
          "reasoning": "medium",
        },
      ],
    },
    "deep-high": {
      "model": "chatgpt-subscription/gpt-6-astra",
      "reasoning": "high",
    },
    "ultrabrain": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "max" },
        { "model": "chatgpt-subscription/gpt-5.6-sol", "reasoning": "max" },
      ],
    },
    "architect": {
      "model": "chatgpt-subscription/gpt-6-astra",
      "reasoning": "high",
    },
    "unspecified-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-5.6-sol", "reasoning": "medium" },
      ],
    },
    "unspecified-high": {
      "model": "chatgpt-subscription/gpt-6.1-sol",
      "reasoning": "high",
    },
    "visual-engineering": {
      "model": "chatgpt-subscription/gpt-6.1-sol",
      "reasoning": "high",
    },
    "artistry": {
      "model": "chatgpt-subscription/gpt-6.1-sol",
      "reasoning": "high",
    },
    "writing": {
      "model": "chatgpt-subscription/gpt-6.1-sol",
      "reasoning": "medium",
    },
  },
}
