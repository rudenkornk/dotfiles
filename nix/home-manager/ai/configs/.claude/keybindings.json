{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Global",
      "bindings": {
        "ctrl+t": null,
        "ctrl+q": "app:toggleTodos",
        "ctrl+o": null,
        "ctrl+g": "app:toggleTranscript",
        "ctrl+x q": "app:exit",
        "ctrl+shift+b": "app:toggleBrief",
        "ctrl+shift+o": "app:toggleTeammatePreview",
        "ctrl+r": "history:search",
        "ctrl+]": "app:openArtifact",
        "ctrl+е": null,
        "ctrl+й": "app:toggleTodos",
        "ctrl+щ": null,
        "ctrl+п": "app:toggleTranscript",
        "ctrl+ч й": "app:exit",
        "ctrl+shift+и": "app:toggleBrief",
        "ctrl+shift+щ": "app:toggleTeammatePreview",
        "ctrl+к": "history:search"
      }
    },
    {
      "context": "Chat",
      "bindings": {
        "escape": "chat:cancel",
        "ctrl+g": null,
        "cmd+k": "chat:clearScreen",
        "ctrl+x ctrl+k": "chat:killAgents",
        "shift+tab": "chat:cycleMode",
        "meta+p": "chat:modelPicker",
        "meta+o": "chat:fastMode",
        "meta+t": "chat:thinkingToggle",
        "meta+w": "chat:workflowKeywordToggle",
        "ctrl+enter": "chat:submit",
        "enter": "chat:newline",
        "shift+enter": "chat:newline",
        "ctrl+p": "history:previous",
        "ctrl+n": "history:next",
        "up": "history:previous",
        "down": "history:next",
        "ctrl+_": "chat:undo",
        "ctrl+-": "chat:undo",
        "ctrl+shift+-": "chat:undo",
        "ctrl+shift+_": "chat:undo",
        "ctrl+x ctrl+e": "chat:externalEditor",
        "meta+e": "chat:externalEditor",
        "ctrl+s": null,
        "meta+s": "chat:stash",
        "ctrl+v": "chat:imagePaste",
        "space": "voice:pushToTalk",
        "ctrl+п": null,
        "cmd+л": "chat:clearScreen",
        "ctrl+ч ctrl+л": "chat:killAgents",
        "meta+з": "chat:modelPicker",
        "meta+щ": "chat:fastMode",
        "meta+е": "chat:thinkingToggle",
        "meta+ц": "chat:workflowKeywordToggle",
        "ctrl+з": "history:previous",
        "ctrl+т": "history:next",
        "ctrl+ч ctrl+у": "chat:externalEditor",
        "meta+у": "chat:externalEditor",
        "ctrl+ы": null,
        "meta+ы": "chat:stash",
        "ctrl+м": "chat:imagePaste"
      }
    },
    {
      "context": "Autocomplete",
      "bindings": {
        "tab": "autocomplete:accept",
        "escape": "autocomplete:dismiss",
        "ctrl+p": "autocomplete:previous",
        "ctrl+n": "autocomplete:next",
        "up": "autocomplete:previous",
        "down": "autocomplete:next",
        "ctrl+з": "autocomplete:previous",
        "ctrl+т": "autocomplete:next"
      }
    },
    {
      "context": "Settings",
      "bindings": {
        "escape": "confirm:no",
        "up": "select:previous",
        "down": "select:next",
        "k": "select:previous",
        "j": "select:next",
        "ctrl+p": "select:previous",
        "ctrl+n": "select:next",
        "space": "select:accept",
        "enter": "settings:close",
        "/": "settings:search",
        "r": "settings:retry",
        "d": "settings:periodDay",
        "w": "settings:periodWeek",
        "t": "settings:sortByTokens",
        "ctrl+u": "scroll:halfPageUp",
        "ctrl+v": "scroll:halfPageDown",
        "л": "select:previous",
        "о": "select:next",
        "ctrl+з": "select:previous",
        "ctrl+т": "select:next",
        "к": "settings:retry",
        "в": "settings:periodDay",
        "ц": "settings:periodWeek",
        "е": "settings:sortByTokens",
        "ctrl+г": "scroll:halfPageUp",
        "ctrl+м": "scroll:halfPageDown"
      }
    },
    {
      "context": "Doctor",
      "bindings": {
        "f": "doctor:fix",
        "а": "doctor:fix"
      }
    },
    {
      "context": "Confirmation",
      "bindings": {
        "y": "confirm:yes",
        "n": "confirm:no",
        "enter": "confirm:yes",
        "escape": "confirm:no",
        "ctrl+p": "confirm:previous",
        "ctrl+n": "confirm:next",
        "up": "confirm:previous",
        "down": "confirm:next",
        "tab": "confirm:nextField",
        "space": "confirm:toggle",
        "shift+tab": "confirm:cycleMode",
        "ctrl+e": "confirm:toggleExplanation",
        "н": "confirm:yes",
        "т": "confirm:no",
        "ctrl+з": "confirm:previous",
        "ctrl+т": "confirm:next",
        "ctrl+у": "confirm:toggleExplanation"
      }
    },
    {
      "context": "Tabs",
      "bindings": {
        "tab": "tabs:next",
        "shift+tab": "tabs:previous",
        "right": "tabs:next",
        "left": "tabs:previous"
      }
    },
    {
      "context": "Transcript",
      "bindings": {
        "ctrl+g": "transcript:toggleShowAll",
        "escape": "transcript:exit",
        "q": "transcript:exit",
        "ctrl+u": "scroll:halfPageUp",
        "ctrl+b": "scroll:fullPageUp",
        "ctrl+f": "scroll:fullPageDown",
        "ctrl+e": "scroll:lineDown",
        "ctrl+y": "scroll:lineUp",
        "ctrl+n": "scroll:lineDown",
        "ctrl+p": "scroll:lineUp",
        "g": "scroll:top",
        "shift+g": "scroll:bottom",
        "j": "scroll:lineDown",
        "k": "scroll:lineUp",
        "space": "scroll:fullPageDown",
        "b": "scroll:fullPageUp",
        "up": "scroll:lineUp",
        "down": "scroll:lineDown",
        "home": "scroll:top",
        "end": "scroll:bottom",
        "ctrl+п": "transcript:toggleShowAll",
        "й": "transcript:exit",
        "ctrl+г": "scroll:halfPageUp",
        "ctrl+и": "scroll:fullPageUp",
        "ctrl+а": "scroll:fullPageDown",
        "ctrl+у": "scroll:lineDown",
        "ctrl+н": "scroll:lineUp",
        "ctrl+т": "scroll:lineDown",
        "ctrl+з": "scroll:lineUp",
        "п": "scroll:top",
        "shift+п": "scroll:bottom",
        "о": "scroll:lineDown",
        "л": "scroll:lineUp",
        "и": "scroll:fullPageUp"
      }
    },
    {
      "context": "HistorySearch",
      "bindings": {
        "ctrl+r": "historySearch:next",
        "escape": "historySearch:accept",
        "tab": "historySearch:accept",
        "enter": "historySearch:execute",
        "ctrl+s": null,
        "meta+s": "historySearch:cycleScope",
        "ctrl+к": "historySearch:next",
        "ctrl+ы": null,
        "meta+ы": "historySearch:cycleScope"
      }
    },
    {
      "context": "Task",
      "bindings": {
        "ctrl+x ctrl+b": "task:background",
        "ctrl+b": "task:background",
        "ctrl+ч ctrl+и": "task:background",
        "ctrl+и": "task:background"
      }
    },
    {
      "context": "ThemePicker",
      "bindings": {
        "ctrl+t": "theme:toggleSyntaxHighlighting",
        "ctrl+e": "theme:editCustom",
        "ctrl+е": "theme:toggleSyntaxHighlighting",
        "ctrl+у": "theme:editCustom"
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "pageup": "scroll:pageUp",
        "pagedown": "scroll:pageDown",
        "ctrl+u": "scroll:halfPageUp",
        "ctrl+v": "scroll:halfPageDown",
        "ctrl+e": "scroll:lineDown",
        "ctrl+y": "scroll:lineUp",
        "wheelup": "scroll:lineUp",
        "wheeldown": "scroll:lineDown",
        "ctrl+home": "scroll:top",
        "ctrl+end": "scroll:bottom",
        "ctrl+shift+c": "selection:copy",
        "cmd+c": "selection:copy",
        "shift+left": "selection:extendLeft",
        "shift+right": "selection:extendRight",
        "shift+up": "selection:extendUp",
        "shift+down": "selection:extendDown",
        "shift+home": "selection:extendLineStart",
        "shift+end": "selection:extendLineEnd",
        "ctrl+г": "scroll:halfPageUp",
        "ctrl+м": "scroll:halfPageDown",
        "ctrl+у": "scroll:lineDown",
        "ctrl+н": "scroll:lineUp",
        "ctrl+shift+с": "selection:copy",
        "cmd+с": "selection:copy"
      }
    },
    {
      "context": "Help",
      "bindings": {
        "escape": "help:dismiss"
      }
    },
    {
      "context": "Attachments",
      "bindings": {
        "right": "attachments:next",
        "left": "attachments:previous",
        "backspace": "attachments:remove",
        "delete": "attachments:remove",
        "down": "attachments:exit",
        "escape": "attachments:exit"
      }
    },
    {
      "context": "Footer",
      "bindings": {
        "up": "footer:up",
        "ctrl+p": "footer:up",
        "down": "footer:down",
        "ctrl+n": "footer:down",
        "right": "footer:next",
        "left": "footer:previous",
        "enter": "footer:openSelected",
        "escape": "footer:clearSelection",
        "x": "footer:close",
        "ctrl+з": "footer:up",
        "ctrl+т": "footer:down",
        "ч": "footer:close"
      }
    },
    {
      "context": "MessageSelector",
      "bindings": {
        "up": "messageSelector:up",
        "down": "messageSelector:down",
        "k": "messageSelector:up",
        "j": "messageSelector:down",
        "ctrl+p": "messageSelector:up",
        "ctrl+n": "messageSelector:down",
        "ctrl+up": "messageSelector:top",
        "shift+up": "messageSelector:top",
        "meta+up": "messageSelector:top",
        "shift+k": "messageSelector:top",
        "ctrl+down": "messageSelector:bottom",
        "shift+down": "messageSelector:bottom",
        "meta+down": "messageSelector:bottom",
        "shift+j": "messageSelector:bottom",
        "enter": "messageSelector:select",
        "л": "messageSelector:up",
        "о": "messageSelector:down",
        "ctrl+з": "messageSelector:up",
        "ctrl+т": "messageSelector:down",
        "shift+л": "messageSelector:top",
        "shift+о": "messageSelector:bottom"
      }
    },
    {
      "context": "DiffDialog",
      "bindings": {
        "escape": "diff:dismiss",
        "ctrl+p": "diff:previousFile",
        "ctrl+n": "diff:nextFile",
        "h": "diff:previousSource",
        "l": "diff:nextSource",
        "left": "diff:previousSource",
        "right": "diff:nextSource",
        "up": "diff:previousFile",
        "down": "diff:nextFile",
        "enter": "diff:viewDetails",
        "j": "diff:nextFile",
        "k": "diff:previousFile",
        "ctrl+u": "scroll:pageUp",
        "ctrl+v": "scroll:pageDown",
        "pageup": "scroll:pageUp",
        "pagedown": "scroll:pageDown",
        "ctrl+f": "scroll:fullPageDown",
        "ctrl+b": "scroll:fullPageUp",
        "space": "scroll:fullPageDown",
        "shift+space": "scroll:fullPageUp",
        "b": "scroll:fullPageUp",
        "g": "scroll:top",
        "shift+g": "scroll:bottom",
        "home": "scroll:top",
        "end": "scroll:bottom",
        "ctrl+з": "diff:previousFile",
        "ctrl+т": "diff:nextFile",
        "р": "diff:previousSource",
        "д": "diff:nextSource",
        "о": "diff:nextFile",
        "л": "diff:previousFile",
        "ctrl+г": "scroll:pageUp",
        "ctrl+м": "scroll:pageDown",
        "ctrl+а": "scroll:fullPageDown",
        "ctrl+и": "scroll:fullPageUp",
        "и": "scroll:fullPageUp",
        "п": "scroll:top",
        "shift+п": "scroll:bottom"
      }
    },
    {
      "context": "ModelPicker",
      "bindings": {
        "h": "modelPicker:decreaseEffort",
        "l": "modelPicker:increaseEffort",
        "d": "modelPicker:setAsDefault",
        "р": "modelPicker:decreaseEffort",
        "д": "modelPicker:increaseEffort",
        "в": "modelPicker:setAsDefault"
      }
    },
    {
      "context": "Select",
      "bindings": {
        "up": "select:previous",
        "down": "select:next",
        "j": "select:next",
        "k": "select:previous",
        "ctrl+n": "select:next",
        "ctrl+p": "select:previous",
        "ctrl+u": "select:pageUp",
        "ctrl+v": "select:pageDown",
        "pageup": "select:pageUp",
        "pagedown": "select:pageDown",
        "home": "select:first",
        "end": "select:last",
        "enter": "select:accept",
        "escape": "select:cancel",
        "о": "select:next",
        "л": "select:previous",
        "ctrl+т": "select:next",
        "ctrl+з": "select:previous",
        "ctrl+г": "select:pageUp",
        "ctrl+м": "select:pageDown"
      }
    },
    {
      "context": "Plugin",
      "bindings": {
        "space": "plugin:toggle",
        "i": "plugin:install",
        "f": "plugin:favorite",
        "ш": "plugin:install",
        "а": "plugin:favorite"
      }
    }
  ]
}
