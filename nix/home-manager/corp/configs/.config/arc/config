[core]
  pager = arc-delta

# Configuration for arc -- exotic VCS from yandex.
[alias]
  bl = blame
  br = branch
  ck = checkout
  cm = commit
  cma = commit --all --message a # Commit all.
  cmd = commit --amend
  cmm = commit --amend
  cms = commit --message s # Commit staged.
  cc = cherry-pick
  df = diff --git
  ft = fetch
  l = log
  lg = log --graph
  ll = log --oneline
  llg = log --oneline --graph
  ls = log --stat
  mb = merge-base
  p = push
  pf = push --force
  rb = rebase
  rbi = rebase --interactive HEAD~26
  rh = reset --hard
  sg = diff --staged --git
  sh = show --git
  st = status
