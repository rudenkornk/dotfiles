{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",

  // Rewrites of this file fail against the read-only store path, and an unmarked migration retries on every start.
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-07-codex-config-jsonc",
    "2026-08-reasoning-unification",
  ],
  "profiles": {}, // Required by the published schema, so omitting it is a standing editor error.

  "[opencode]": {
    "telemetry": false,
    "auto_update": false,
    "model_capabilities": {
      "auto_refresh_on_start": false, // Avoids a ~1MiB fetch on every session start.
    },

    "disabled_mcps": ["lsp"], // `OPENCODE_EXPERIMENTAL_LSP_TOOL` in `ai.nix` covers this natively.
    "disabled_hooks": [
      "session-notification",
      "ast-grep-sg-provision",
      "startup-toast",
    ],

    // `ast-grep` is absent deliberately: matching is by name alone, so it would drop the nixpkgs skill too.
    "disabled_skills": [
      "lsp-setup",
      "ultimate-browsing",
      "security-research",
      "security-review",
    ],

    "browser_automation_engine": {
      "provider": "playwright-cli", // The default provider launches its MCP through `npx`.
    },

    "codegraph": {
      "enabled": true,
      "auto_init": true,
      "auto_provision": false,
      "daemon": true,
      "telemetry": false,
    },

    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "", // A non-empty prefix rewrites the git commands inside the skill text.
    },

    "start_work": {
      "auto_commit": false,
    },

    "experimental": {
      "task_system": true,
      "disable_omo_env": true, // The injected date and locale break OpenAI prompt caching.
    },

    "runtime_fallback": {
      "enabled": true, // Without this, `fallback_models` covers an unreachable model but not a rate limit.
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true,
    },

    "background_task": {
      "defaultConcurrency": 5,
      // A `modelConcurrency` entry gives that model its own bucket, raising rather than capping the total.
      "providerConcurrency": {
        "openai": 5,
      },
    },

    // An explicit `model` short-circuits the chain that would otherwise supply a variant, so each entry pins one.
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        // GLM 5.2 is the only orchestrator reachable here that upstream still calibrates a prompt for.
        "fallback_models": [
          "openrouter/z-ai/glm-5.2:free",
          "openrouter/z-ai/glm-5.2",
        ],
      },
      // A non-GPT model reroutes Hephaestus to Sisyphus, so a fallback chain would never fire.
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
      },
      // Upstream offers no OpenAI rung for either agent, and Metis also loses its prompt, hence the extra effort.
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
      },
      "metis": {
        "model": "openai/gpt-5.6-sol",
        "variant": "max",
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
      },
      "atlas": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "variant": "low",
      },
      "explore": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "low",
        // NOTE: A variant survives a fallback entry only in object form; `model:max` is dropped when parsed.
        "fallback_models": [
          {
            "model": "openrouter/deepseek/deepseek-v4-flash",
            "variant": "max",
          },
          { "model": "deepseek/deepseek-v4-flash", "variant": "max" },
        ],
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openrouter/deepseek/deepseek-v4-flash",
            "variant": "max",
          },
          { "model": "deepseek/deepseek-v4-flash", "variant": "max" },
        ],
      },
    },

    "categories": {
      "deep": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "variant": "max",
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
      },
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      // Every rung of the built-in chain is unreachable here, which otherwise hides this category.
      "artistry": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
      },
      // The built-in chain lands on Gemini, off the subscription.
      "writing": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
      },
      // The built-in GPT rung sits under a `quotio-openai` provider, unavailable here.
      "quick": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openrouter/deepseek/deepseek-v4-flash",
            "variant": "off",
          },
          { "model": "deepseek/deepseek-v4-flash", "variant": "off" },
        ],
      },
    },
  },
}
