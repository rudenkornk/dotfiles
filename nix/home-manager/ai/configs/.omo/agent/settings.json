{
  "defaultProvider": "chatgpt-subscription",
  "defaultModel": "gpt-6.1-sol-fast",
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "skills": ["~/.claude/skills"],
  "permissionPreset": "full-access",
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/Downloads/**": "allow",
      "~/projects/arcadia*/**": "allow",
      "~/projects/cloudia*/**": "allow",
      "~/projects/dotfiles/**": "allow",
      "~/projects/home-manager/**": "allow",
      "~/projects/nixpkgs/**": "allow",
      "~/.cache/**": "allow",
      "~/.cargo/registry/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow",
      "~/.local/state/**": "allow",
      "~/.claude/skills/**": "allow",
      "/bin/**": "allow",
      "/dev/**": "allow",
      "/etc/**": "allow",
      "/lib64/**": "allow",
      "/nix/**": "allow",
      "/run/**": "allow",
      "/sys/**": "allow",
      "/tmp/**": "allow",
      "/usr/**": "allow",
      "/var/**": "allow",
      "/run/user/*/secrets/*": "deny",
      "~/.config/google-chrome/*": "deny",
      "~/.config/mozilla/*": "deny",
      "~/.config/sops/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.local/share/atuin/key": "deny",
      "~/.local/share/keyrings/*": "deny",
      "~/.local/share/TelegramDesktop/*": "deny",
      "~/.pki/*": "deny"
    },
    "edit": {
      "*": "allow",
      "/**": "ask",
      "/etc/**": "ask",
      "/run/**": "ask",
      "/tmp/**": "allow",
      "/bin/**": "deny",
      "/dev/**": "deny",
      "/lib64/**": "deny",
      "/nix/**": "deny",
      "/sys/**": "deny",
      "/usr/**": "deny",
      "/var/**": "deny"
    }
  }
}
