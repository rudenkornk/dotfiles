{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@slkiser/opencode-quota@4.8.2"],
  "subagent_depth": 2,
  "permission": {
    "external_directory": {
      // "allow" rules allow both reads and writes.
      "*": "ask",
      "~/Downloads/**": "allow",
      "~/projects/arcadia*/**": "allow",
      "~/projects/dotfiles/**": "allow",
      "~/projects/home-manager/**": "allow",
      "~/projects/nixpkgs/**": "allow",

      "~/.cache/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow",
      "~/.local/state/**": "allow",

      "/bin/**": "allow",
      "/dev/**": "allow",
      "/etc/**": "allow",
      "/lib64/**": "allow",
      "/nix/**": "allow",
      "/run/**": "allow",
      "/sys/**": "allow",
      "/tmp/**": "allow",
      "/usr/**": "allow",
      "/var/**": "allow",

      "/run/user/*/secrets/*": "deny",
      "~/.config/google-chrome/*": "deny",
      "~/.config/mozilla/*": "deny",
      "~/.config/sops/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.local/share/atuin/key": "deny",
      "~/.local/share/keyrings/*": "deny",
      "~/.local/share/TelegramDesktop/*": "deny",
      "~/.pki/*": "deny",
    },

    "edit": {
      // These rules are not effective, only written for future reference.
      // Blocked by these issues/PRs:
      // https://github.com/anomalyco/opencode/pull/40149
      // https://github.com/anomalyco/opencode/pull/41070
      // After merge & update these rules may require adjustments.

      "*": "allow", // CWD.
      "/**": "ask",
      "/etc/**": "ask",
      "/run/**": "ask",

      "/tmp/**": "allow",

      "/bin/**": "deny",
      "/dev/**": "deny",
      "/lib64/**": "deny",
      "/nix/**": "deny",
      "/sys/**": "deny",
      "/usr/**": "deny",
      "/var/**": "deny",
    },
  },
  "lsp": {},
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["mcp-nixos"],
    },
    // INSERTION POINT.
  },
  "provider": {
    "openai": {},
  },
}
