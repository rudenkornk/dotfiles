{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@slkiser/opencode-quota@4.8.2"],
  "subagent_depth": 2,
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/projects/dotfiles/**": "allow",
      "~/projects/arcadia/**": "allow",

      "/run/user/*/secrets/*": "deny",
      "~/.config/sops/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.pki/*": "deny",
      "~/.local/share/keyrings/*": "deny",
      "~/.local/share/TelegramDesktop/*": "deny",
      "~/.config/mozilla/*": "deny",
      "~/.config/google-chrome/*": "deny",
    },
  },
  "lsp": {},
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["mcp-nixos"],
    },
    // INSERTION POINT.
  },
  "provider": {
    "openai": {},
  },
}
